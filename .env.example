# Application
APP_NAME="Laravel Taskboard"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Non-sensitive deployment revision markers (shown in the UI footer and /version).
# Set APP_RELEASE to a build/deploy identifier and APP_COMMIT to the source SHA.
APP_RELEASE=dev
APP_COMMIT=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Logs go to stderr so container/paas platforms capture them on stdout/stderr.
# Set LOG_CHANNEL=single to write to storage/logs/laravel.log instead.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (SQLite default with an explicit persistent path).
# Persistence requirement: DB_DATABASE must live on a persistent volume/external
# database, never only inside an ephemeral release directory.
DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/laravel-taskboard/database.sqlite

# Alternative: point at your own SQLite file
#DB_CONNECTION=sqlite
#DB_DATABASE=/persistent/volume/database.sqlite

# Session: database-backed sessions (a real session table, not file cookies).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache and queue: database-backed so one process serves everything.
CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail is write-to-log so no credentials are required for a demo deployment.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="taskboard@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"